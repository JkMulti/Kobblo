    <string name="smart_search">스마트 검색</string>
    <string name="smart_search_body">\"해변의 강아지\"처럼 사진을 설명해 찾을 수 있습니다.</string>
    <string name="smart_text">사진 속 텍스트</string>
    <string name="smart_text_body">사진 속 단어로 사진을 찾고, 사진에서 텍스트를 복사할 수 있습니다.</string>
    <string name="smart_people">인물</string>
    <string name="smart_people_body">인물별로 사진을 모아 주며, 이름을 붙일 수 있습니다.</string>
