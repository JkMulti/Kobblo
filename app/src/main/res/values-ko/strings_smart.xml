    <string name="smart_quality_footer">정확도 우선은 더 많이 찾아냅니다. 속도 우선은 공간을 덜 차지하며 메모리가 적은 휴대전화에 적합합니다.</string>
    <string name="smart_downloads_header">다운로드</string>
