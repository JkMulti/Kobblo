    <string name="vault_save_and_open">저장하고 금고 열기</string>
    <string name="vault_new_password_failed">새 비밀번호를 저장할 수 없습니다. 저장공간을 확보한 후 다시 시도하세요.</string>
    <string name="vault_security_title">비밀번호 및 복구 키</string>
