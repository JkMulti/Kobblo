    <string name="transfer_create_title">Crear una conexión</string>
    <string name="transfer_create_subtitle">¿Sin Wi-Fi? Crea una red entre dos teléfonos</string>
    <string name="transfer_create_subtitle_on">Activada</string>
    <string name="transfer_create_intro">Este teléfono crea su propia red Wi-Fi pequeña y el otro teléfono se une a ella escaneando un código. No necesita Wi-Fi ni usa datos móviles, y no conecta ninguno de los teléfonos a internet.</string>
    <string name="transfer_create_start">Crear conexión</string>
    <string name="transfer_create_stop">Detener conexión</string>
    <string name="transfer_create_scan_prompt">En el otro teléfono, ve a Conectar con un código y luego a Escanear.</string>
    <string name="transfer_create_running_note">Mientras esté activada, este teléfono se desconecta de tu Wi-Fi habitual si el hardware no puede hacer ambas cosas.</string>
    <string name="transfer_create_fallback">Si sigue fallando, el punto de acceso normal de un teléfono también sirve: actívalo, únete a él desde el otro teléfono y conéctate con un código o una dirección.</string>
    <string name="transfer_try_again">Reintentar</string>
    <string name="transfer_open_location_settings">Abrir ajustes de ubicación</string>
    <string name="transfer_hotspot_incompatible">No se pudo iniciar. Puede que ya esté activado un punto de acceso normal o la opción de compartir conexión; desactívalo primero.</string>
    <string name="transfer_hotspot_no_channel">No se pudo iniciar porque ahora mismo no hay ningún canal Wi-Fi libre.</string>
    <string name="transfer_hotspot_disallowed">Este teléfono no permite crear una red. Puede que lo estén bloqueando sus ajustes o un perfil de trabajo.</string>
    <string name="transfer_hotspot_location_off">En esta versión, Android necesita que la ubicación esté activada para crear una red.</string>
    <string name="transfer_hotspot_needs_nearby">Se necesita el permiso Dispositivos cercanos, que se denegó.</string>
    <string name="transfer_hotspot_needs_location">Se necesita el permiso Ubicación, que se denegó.</string>
    <string name="transfer_hotspot_no_credentials">Se inició, pero el sistema no indicó el nombre ni la contraseña de la red, así que se desactivó.</string>
    <string name="transfer_hotspot_unknown">Este teléfono se negó a crear una red. Puede que no sea compatible.</string>
    <string name="web_share_title">Enviar a un ordenador</string>
    <string name="web_share_subtitle">Un enlace para cualquier navegador, en un ordenador o en un teléfono sin esta aplicación</string>
    <string name="web_share_switch">Compartir por web</string>
    <string name="web_share_on">Activado. Tienes que dejar entrar a cada navegador con el enlace antes de que vea nada.</string>
    <string name="web_share_off">Desactivado</string>
    <string name="web_share_starting">Iniciando</string>
    <string name="web_share_intro">Actívalo y abre el enlace en un navegador de un ordenador conectado a la misma red. Se te pedirá que lo permitas. Después, podrá aceptar lo que elijas aquí y pedir enviar archivos a este teléfono.</string>
    <string name="web_share_qr_description">Código QR del enlace de Compartir por web</string>
    <string name="web_share_warning">Este enlace usa HTTP sin cifrar, así que cualquiera en esta red que vea el tráfico podría leer estos archivos. Úsalo en redes de confianza.</string>
    <string name="web_share_files">Archivos compartidos</string>
    <string name="web_share_no_files">No has elegido nada</string>
    <string name="web_share_upload_note">Toca para elegir. El navegador también puede pedir enviarte archivos.</string>
