<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="smart_title">スマート機能</string>
    <string name="smart_subtitle">写っているもので写真を探したり、写真内の文字を読み取ったり、人物ごとに写真をまとめたりできます。処理はすべて端末上で行われます。</string>
    <string name="smart_settings_row_body">スマート検索、写真内のテキスト、人物</string>
    <string name="smart_features_header">機能</string>
    <string name="smart_search">スマート検索</string>
    <string name="smart_search_body">「海辺の犬」のように説明して写真を探せます。</string>
    <string name="smart_text">写真内のテキスト</string>
    <string name="smart_text_body">写真に含まれる文字で検索したり、写真からテキストをコピーしたりできます。</string>
    <string name="smart_people">人物</string>
    <string name="smart_people_body">人物ごとに写真をまとめ、名前を付けられます。</string>
    <string name="smart_quality_accurate">高精度</string>
    <string name="smart_quality_fast">高速</string>
    <string name="smart_quality_size">ダウンロードサイズ: %1$s</string>
    <string name="smart_quality_size_recommended">ダウンロードサイズ: %1$s · この端末におすすめ</string>
    <string name="smart_quality_footer">「高精度」はより多くを見つけられます。「高速」は容量が小さく、メモリの少ない端末に適しています。</string>
    <string name="smart_downloads_header">ダウンロード</string>
    <string name="smart_wifi_only">Wi-Fi接続時のみダウンロード</string>
    <string name="smart_wifi_only_body">モデルはサイズが大きいため、Wi-Fiに接続されるまで待機します。</string>
    <string name="smart_source_footer">モデルはHugging Faceから一度だけダウンロードされ、使用前に検証されます。写真や検出された内容が端末の外に送信されることはありません。</string>
    <string name="smart_indexing_header">写真の読み込み</string>
    <string name="smart_while_charging">充電中</string>
    <string name="smart_while_charging_body">電源に接続しているときだけ実行するため、バッテリーを消費しません。</string>
    <string name="smart_overnight">夜間</string>
    <string name="smart_overnight_body">午前1時〜7時に実行します（電源接続の有無を問いません）。</string>
    <string name="smart_index_now">新しい写真を今すぐ読み込む</string>
    <string name="smart_index_footer">端末が熱くなったときやバッテリー残量が少ないときは一時停止します。</string>
    <string name="smart_status_off">未ダウンロード（%1$s）</string>
    <string name="smart_status_waiting">Wi-Fiを待機中</string>
    <string name="smart_status_queued">ダウンロード待機中</string>
    <string name="smart_status_downloading">ダウンロード中 · %1$s / %2$s</string>
    <string name="smart_status_ready">オン</string>
    <string name="smart_status_update">オン · アップデートがあります</string>
    <string name="smart_status_reading">写真を読み込み中 · %1$s / %2$s</string>
    <string name="smart_update">アップデート</string>
    <string name="smart_unsupported">スマート機能にはAndroid 11以降が必要です。</string>
    <string name="smart_remove_title">%1$s をオフにしますか？</string>
    <string name="smart_remove_body">モデルと検出結果が削除されます。いつでも再ダウンロードできます。</string>
    <string name="smart_remove_people_body">モデル、検出された人物、付けた名前が削除されます。</string>
    <string name="smart_remove">オフにする</string>
    <string name="smart_search_section">スマート検索の結果</string>
    <string name="smart_people_title">人物</string>
    <string name="smart_people_see_all">すべて表示</string>
    <string name="smart_people_add_name">名前を追加</string>
    <string name="smart_people_name_title">この人物に名前を付ける</string>
    <string name="smart_people_rename_title">名前を変更</string>
    <string name="smart_people_name_action">完了</string>
    <string name="smart_people_hide">この人物を非表示</string>
    <string name="smart_people_empty">人物はまだありません</string>
    <string name="smart_people_empty_body">写真が読み込まれると、ここに人物が表示されます。読み込みは端末の充電中に行われます。</string>
