        <item quantity="one">You rejected %1$d item.</item>
        <item quantity="other">You rejected %1$d items.</item>
    </plurals>
    <!-- %1$s is the phone's name. %2$s is what's coming: transfer_incoming_summary, share_web_offer_notes, or share_web_offer_both. -->
    <string name="share_web_offer_title">%1$s wants to send you %2$s</string>
    <plurals name="share_web_offer_notes">
        <item quantity="one">a note</item>
        <item quantity="other">%1$d notes</item>
    </plurals>
    <!-- Files and notes together: %1$s is the files (transfer_incoming_summary), %2$s the notes (share_web_offer_notes). -->
    <string name="share_web_offer_both">%1$s and %2$s</string>
