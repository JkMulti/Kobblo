<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Web Share's page, as it shows in someone else's browser. The phone is the phone running this app. -->
    <string name="share_web_loading">Loading files</string>
    <string name="share_web_download_all">Download all</string>
    <string name="share_web_download">Download</string>
    <string name="share_web_changed_mind">Changed your mind?</string>
    <string name="share_web_send_to_phone">Send to this phone</string>
