<resources>
    <!-- Smart Features -->
    <string name="smart_title">Smart Features</string>
    <string name="smart_subtitle">Find photos by what\'s in them, read the text in them, and see everyone\'s photos together. It all happens on your phone.</string>
    <string name="smart_settings_row_body">Smart Search, text in photos and people</string>
    <string name="smart_features_header">Features</string>
    <string name="smart_search">Smart Search</string>
    <string name="smart_search_body">Describe a photo to find it, like \"dog on the beach\".</string>
    <string name="smart_text">Text in Photos</string>
    <string name="smart_text_body">Find photos by the words in them, and copy text from any photo.</string>
    <string name="smart_people">People</string>
    <string name="smart_people_body">Puts the photos of each person together, for you to name.</string>
    <string name="smart_quality_accurate">Accurate</string>
    <string name="smart_quality_fast">Fast</string>
    <string name="smart_quality_size">%1$s download</string>
    <string name="smart_quality_size_recommended">%1$s download · Recommended for this phone</string>
    <string name="smart_quality_footer">Accurate finds more. Fast takes less space and suits phones with less memory.</string>
    <string name="smart_downloads_header">Downloads</string>
    <string name="smart_wifi_only">Download on Wi-Fi Only</string>
    <string name="smart_wifi_only_body">Models are large, so they wait for Wi-Fi.</string>
    <string name="smart_source_footer">Models come from Hugging Face, once, and are checked before use. Your photos and what\'s found in them never leave your phone.</string>
    <string name="smart_indexing_header">Reading Your Photos</string>
    <string name="smart_while_charging">While Charging</string>
    <string name="smart_while_charging_body">Only when plugged in, so it never costs battery.</string>
    <string name="smart_overnight">Overnight</string>
    <string name="smart_overnight_body">From 1 to 7 AM, plugged in or not.</string>
    <string name="smart_index_now">Read New Photos Now</string>
    <string name="smart_index_footer">It pauses when the phone gets warm or the battery is low.</string>

