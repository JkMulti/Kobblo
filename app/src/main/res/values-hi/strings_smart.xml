<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="smart_title">स्मार्ट सुविधाएँ</string>
    <string name="smart_subtitle">फ़ोटो में मौजूद चीज़ों से उन्हें खोजें, उनमें लिखा टेक्स्ट पढ़ें, और हर व्यक्ति की फ़ोटो एक साथ देखें। यह सब आपके फ़ोन पर ही होता है।</string>
    <string name="smart_settings_row_body">स्मार्ट खोज, फ़ोटो में टेक्स्ट और लोग</string>
    <string name="smart_features_header">सुविधाएँ</string>
    <string name="smart_search">स्मार्ट खोज</string>
    <string name="smart_search_body">किसी फ़ोटो को खोजने के लिए उसका वर्णन करें, जैसे \"समुद्र तट पर कुत्ता\"।</string>
    <string name="smart_text">फ़ोटो में टेक्स्ट</string>
    <string name="smart_text_body">फ़ोटो में लिखे शब्दों से उन्हें खोजें, और किसी भी फ़ोटो से टेक्स्ट कॉपी करें।</string>
    <string name="smart_people">लोग</string>
    <string name="smart_people_body">हर व्यक्ति की फ़ोटो एक साथ रखता है, ताकि आप उन्हें नाम दे सकें।</string>
    <string name="smart_quality_accurate">सटीक</string>
    <string name="smart_quality_fast">तेज़</string>
    <string name="smart_quality_size">%1$s डाउनलोड</string>
    <string name="smart_quality_size_recommended">%1$s डाउनलोड · इस फ़ोन के लिए सुझाया गया</string>
    <string name="smart_quality_footer">सटीक ज़्यादा चीज़ें ढूँढता है। तेज़ कम जगह लेता है और कम मेमोरी वाले फ़ोन के लिए सही है।</string>
    <string name="smart_downloads_header">डाउनलोड</string>
    <string name="smart_wifi_only">सिर्फ़ Wi-Fi पर डाउनलोड करें</string>
    <string name="smart_wifi_only_body">मॉडल बड़े होते हैं, इसलिए ये Wi-Fi का इंतज़ार करते हैं।</string>
    <string name="smart_source_footer">मॉडल Hugging Face से सिर्फ़ एक बार डाउनलोड होते हैं, और इस्तेमाल से पहले उनकी जाँच की जाती है। आपकी फ़ोटो और उनमें मिली जानकारी कभी आपके फ़ोन से बाहर नहीं जाती।</string>
    <string name="smart_indexing_header">आपकी फ़ोटो पढ़ना</string>
    <string name="smart_while_charging">चार्ज होते समय</string>
    <string name="smart_while_charging_body">सिर्फ़ प्लग इन होने पर, ताकि बैटरी कभी खर्च न हो।</string>
    <string name="smart_overnight">रात भर</string>
    <string name="smart_overnight_body">रात 1 बजे से सुबह 7 बजे तक, प्लग इन हो या न हो।</string>
    <string name="smart_index_now">नई फ़ोटो अभी पढ़ें</string>
    <string name="smart_index_footer">फ़ोन गर्म होने या बैटरी कम होने पर यह रुक जाता है।</string>
    <string name="smart_status_off">%1$s डाउनलोड करना है</string>
    <string name="smart_status_waiting">Wi-Fi का इंतज़ार है</string>
    <string name="smart_status_queued">डाउनलोड होने का इंतज़ार है</string>
    <string name="smart_status_downloading">डाउनलोड हो रहा है · %2$s में से %1$s</string>
    <string name="smart_status_ready">चालू</string>
    <string name="smart_status_update">चालू · अपडेट तैयार है</string>
    <string name="smart_status_reading">फ़ोटो पढ़ी जा रही हैं · %2$s में से %1$s</string>
    <string name="smart_update">अपडेट करें</string>
    <string name="smart_unsupported">स्मार्ट सुविधाओं के लिए Android 11 या उसके बाद का वर्शन चाहिए।</string>
    <string name="smart_remove_title">%1$s बंद करें?</string>
    <string name="smart_remove_body">इसका मॉडल और इसमें मिली जानकारी हटा दी जाएगी। आप इसे कभी भी फिर से डाउनलोड कर सकते हैं।</string>
    <string name="smart_remove_people_body">इसका मॉडल, इसमें मिले लोग और उनके नाम हटा दिए जाएँगे।</string>
    <string name="smart_remove">बंद करें</string>
    <string name="smart_search_section">स्मार्ट खोज से मिली</string>
    <string name="smart_people_title">लोग</string>
    <string name="smart_people_see_all">सभी देखें</string>
    <string name="smart_people_add_name">नाम जोड़ें</string>
    <string name="smart_people_name_title">इस व्यक्ति को नाम दें</string>
    <string name="smart_people_rename_title">नाम बदलें</string>
    <string name="smart_people_name_action">हो गया</string>
    <string name="smart_people_hide">इस व्यक्ति को छिपाएँ</string>
    <string name="smart_people_empty">अभी कोई व्यक्ति नहीं</string>
    <string name="smart_people_empty_body">आपकी फ़ोटो पढ़ी जाने पर लोग यहाँ दिखने लगते हैं, और यह फ़ोन चार्ज होते समय होता है।</string>
    <string name="smart_text_button">टेक्स्ट</string>
